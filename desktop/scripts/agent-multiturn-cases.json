[
  {
    "id": "MT01",
    "title": "改型号 → 撤销 → 改数量",
    "context": {
      "domain": "elec",
      "view": "底板",
      "selection": { "kind": "placement", "id": "p1", "label": "QF1" },
      "machine": { "name": "烟包机", "stations": 3, "actuators": 6, "sensors": 8 },
      "plate": { "width": 600, "height": 400, "placed": 2, "overlaps": 0 },
      "bomRows": 2,
      "hasCadModel": true,
      "placements": [
        { "id": "p1", "label": "QF1", "model": "iC65N-C16-1P", "qty": 1, "x": 20, "y": 30, "w": 36, "h": 80 },
        { "id": "p2", "label": "KM1", "model": "LC1D09", "qty": 1, "x": 80, "y": 30, "w": 45, "h": 80 }
      ]
    },
    "turns": [
      {
        "prompt": "把 QF1 的型号改成 NXB-63 3P C32",
        "confirm": "allow",
        "expect": {
          "tools": [
            {
              "tool": "update_component",
              "args": [
                { "ref": "QF1", "model": { "contains": "NXB" } },
                { "partId": "iC65N-C16-1P", "model": { "contains": "NXB" } },
                { "ref": "QF1", "newModel": { "contains": "NXB" } }
              ]
            }
          ],
          "mustNot": ["insert_component", "remove_component"]
        }
      },
      {
        "prompt": "撤销刚才的型号修改",
        "confirm": "allow",
        "expect": {
          "tools": [{ "tool": "undo_last" }],
          "mustNot": ["update_component", "remove_component"]
        }
      },
      {
        "prompt": "接着把刚才那个件的数量改成 2",
        "confirm": "allow",
        "expect": {
          "tools": [
            {
              "tool": "update_component",
              "args": [
                { "ref": "QF1", "qty": 2 },
                { "partId": "iC65N-C16-1P", "qty": 2 }
              ]
            }
          ],
          "mustNot": ["insert_component", "remove_component"]
        }
      }
    ]
  },

{
  "name": "automation-cad-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "非标自动化整机设计软件 · Windows 11 桌面版",
  "author": "owlco",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:ext": "tsc --noEmit && vite build && node scripts/build-electron.mjs && node scripts/build-mcp.mjs",
    "start": "electron .",
    "test": "node --test",
    "sync:e2e": "bash ../scripts/sync-e2e.sh",
    "eval:agent": "node eval/run-eval.mjs",
    "eval:agent:multiturn": "node scripts/agent-multiturn.mjs",
    "kb:build": "node scripts/build-kb.mjs",
    "build:machine-case": "node scripts/build-machine-case.mjs",
    "bench:render": "node scripts/bench-render-plan.mjs",
    "smoke": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run -a electron . --headless-smoke",
    "diagnose": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run -a electron . --diagnose",
    "packs:validate": "node ../scripts/pack-validate.mjs",
    "packs:stats": "node ../scripts/pack-stats.mjs",
    "packs:add": "node ../scripts/pack-add.mjs",
    "perf:baseline": "node --expose-gc scripts/perf-baseline.mjs",
    "check:orbit-webgl": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run -a -s \"-screen 0 1700x1100x24\" electron scripts/orbit-webgl-check.cjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:machine": "npm run build:ext && node scripts/capture-machine-screenshots.mjs",
    "dist:win": "electron-builder --win nsis --x64",
    "build:mcp": "node scripts/build-mcp.mjs",
    "mcp": "node dist-electron/mcp.cjs",
    "agent:live": "node scripts/agent-live.mjs",
    "agent:report": "node scripts/agent-report.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "adm-zip": "^0.5.16",
    "dxf-writer": "^1.18.4",
    "electron-updater": "6.8.11",
    "modbus-serial": "^8.0.25",
    "mqtt": "^5.14.1",
    "node-opcua": "2.186.15",
    "occt-import-js": "0.0.23",
    "three": "^0.186.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.7.2",
    "@types/three": "^0.186.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "build": {
    "appId": "cn.automationcad.desktop",
    "productName": "AutomationCAD",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../packs/builtin",
        "to": "packs/builtin"
      },
      {
        "from": "../index.html",
        "to": "web/index.html"
      },
      {
        "from": "../app.js",
        "to": "web/app.js"
      },
      {
        "from": "../styles.css",
        "to": "web/styles.css"
      },
      {
        "from": "../electrical.js",
        "to": "web/electrical.js"
      },
      {
        "from": "../electrical.css",
        "to": "web/electrical.css"
      },
      {
        "from": "../spike/build123d/app.py",
        "to": "parametric/app.py"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "owlco001",
      "repo": "automation-cad-prototype",
      "channel": "latest"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "artifactName": "AutomationCAD-Setup-${version}.${ext}"
    }
  }
}
